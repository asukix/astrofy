---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).filter((p) => !p.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const last_posts = posts.slice(0, 3);

const deepBits = (await getCollection("deep-bits")).filter((p) => !p.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const last_bits = deepBits.slice(0, 4);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Seng</div>
    <div class="text-3xl py-3 font-bold">I'm an iOS engineer with an architecture and meta focus</div>
    <div class="py-2">
      <text class="text-lg">        
Please enjoy my post and thinking. I am planning 3 formats for reading:
<br> - <b>Deep Bits:</b> small and deep thoughts for quick read
<br> - <b>Blog:</b> Usual format for reading articles
<br> - <b>Thinking Articles</b> (Will be released soon): Similar than the blog with different reading experience where you have spece for thinking with me and get an extra take away at the end.
       <p><br><b>NOTE: Page is under construction. We will start around Jul-Aug 2026</b></p>
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="https://twitter.com/manuelernestog" target="_blank"> Let's connect!</a>

    </div>
  </div>



  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Latest from blog</div>
  </div>

{
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }

  <div class="mt-10">
    <div class="text-3xl w-full font-bold mb-5">Deep Bits</div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {last_bits.map((bit) => (
        <a
          href={"/deep-bits/" + createSlug(bit.data.title, bit.slug)}
          class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%] p-5 flex flex-col gap-2"
        >
          <div class="flex items-center gap-2">
            <span class="font-bold text-lg leading-snug">{bit.data.title}</span>
            {bit.data.badge && <span class="badge badge-secondary shrink-0">{bit.data.badge}</span>}
          </div>
          {bit.data.description && <p class="text-sm opacity-75 leading-snug">{bit.data.description}</p>}
        </a>
      ))}
    </div>
  </div>
<div class="divider my-0" />

  <div class="mt-10">
    <div class="text-3xl w-full font-bold mb-2">My last projects {"</>"}</div>
  </div>

  <HorizontalCard
    title="MVI Notes App"
    desc="MVINotes — Notes app demonstrating MVI architecture (Store → Controller → Reducer) with Clean Architecture layering, multi-target test strategy across XCTest and Swift Testing.
Swift · SwiftUI · CoreData · XCTest · Swift Testing"
    url="https://github.com/asukix/MVINotes"
    badge="Architecture"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Orderly App"
    desc="Orderly — UIKit food ordering app exploring the Coordinator pattern with closure-based navigation, MVVM + Clean Architecture, and UIKit/SwiftUI interop via UIHostingController.
Swift · UIKit · SwiftUI · Combine · async/await · CoreData"
    url="https://github.com/asukix/Orderly"
  />
  
</BaseLayout>
