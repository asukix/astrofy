---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).filter((p) => !p.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const last_posts = posts.slice(0, 3);

const deepBits = (await getCollection("deep-bits")).filter((p) => !p.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const last_bits = deepBits.slice(0, 4);

const thinkingBits = (await getCollection("thinking-bits")).filter((p) => !p.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const last_thinking_bits = thinkingBits.slice(0, 4);

const thinkingArticles = (await getCollection("thinking-articles")).filter((p) => !p.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const last_thinking = thinkingArticles.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Seng</div>
    <div class="text-3xl py-3 font-bold">I'm an iOS engineer with an architecture and meta focus</div>
    <div class="py-2">
      <text class="text-lg">        
Welcome on my side and enjoy my space of thinking. You can find 4 type of articles with different aspect of thinking:

<br> - <b>Blog:</b> Usual format of my articles.
<br> - <b>Deep Bits:</b> Short and deep thoughts for quick read.
<br> - <b>Thinking articles (will be released soon):</b>  Special articles with space for thinking.
<br> - <b>Thinking Bits:</b> Similar to Deep Bits but with space for thinking.
<br>In my opinion mental models and understanding are changing. So my articles are snapshots about my mental models when I wrote them. If we have space for thinking we have space to change our models.
<br><br> - <b>NOTE:</b> Thinking Article functionality planned release is August.
      </text>
    </div>
    <div class="mt-8">
      <a class="btn btn-neutral" href="https://twitter.com/manuelernestog" target="_blank"> Let's connect!</a>

    </div>
  </div>

  <div class="divider divider-neutral my-10"></div>

  <div>
    <div class="text-3xl w-full font-bold mb-6">Thinking Content</div>

    <div class="text-xl font-bold mb-4">Thinking Bits</div>
    {
      last_thinking_bits.length === 0 ? (
        <p class="opacity-70 mb-8">No Thinking Bits yet. Check back later!</p>
      ) : (
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-9 mb-8">
          {last_thinking_bits.map((bit) => (
            <div class="rounded-xl bg-base-200 border-l-4 border-l-neutral hover:bg-base-100 hover:shadow-lg transition ease-in-out hover:scale-[102%] flex flex-col overflow-hidden">
              <a href={"/thinking-bits/" + createSlug(bit.data.title, bit.slug)} class="p-4 flex flex-col gap-2 grow">
                {bit.data.badge && <span class="badge badge-secondary w-fit">{bit.data.badge}</span>}
                <span class="font-bold text-base leading-snug">{bit.data.title}</span>
                {bit.data.description && <p class="text-xs opacity-70 leading-snug">{bit.data.description}</p>}
              </a>
              {bit.data.tags && bit.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-1 px-4 pb-3">
                  {bit.data.tags.map((tag) => (
                    <a href={`/thinking-bits/tag/${tag}`} class="badge badge-outline badge-sm">{tag}</a>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      )
    }

    <div class="text-xl font-bold mb-4">Thinking Articles</div>
    {
      last_thinking.map((post, index) => (
        <>
          <HorizontalCard
            title={post.data.title}
            img={post.data.heroImage}
            desc={post.data.description}
            url={"/thinking-articles/" + createSlug(post.data.title, post.slug)}
            target="_self"
            badge={post.data.badge}
          />
          {index < last_thinking.length - 1 && <div class="divider my-0" />}
        </>
      ))
    }
  </div>

  <div class="divider divider-neutral my-10"></div>

  <div>
    <div class="text-3xl w-full font-bold mb-5">Deep Bits</div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-9">
      {last_bits.map((bit) => (
        <div class="rounded-xl bg-base-200 border-l-4 border-l-neutral hover:bg-base-100 hover:shadow-lg transition ease-in-out hover:scale-[102%] flex overflow-hidden">
          <div class="flex flex-col grow">
            <a href={"/deep-bits/" + createSlug(bit.data.title, bit.slug)} class="p-4 flex flex-col gap-2 grow">
              {bit.data.badge && <span class="badge badge-secondary w-fit">{bit.data.badge}</span>}
              <span class="font-bold text-base leading-snug">{bit.data.title}</span>
              {bit.data.description && <p class="text-xs opacity-70 leading-snug">{bit.data.description}</p>}
            </a>
            {bit.data.tags && bit.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-1 px-4 pb-3">
                {bit.data.tags.map((tag) => (
                  <a href={`/deep-bits/tag/${tag}`} class="badge badge-outline badge-sm">{tag}</a>
                ))}
              </div>
            )}
          </div>
          {bit.data.thinkingBit && (
            <a
              href={`/thinking-bits/${bit.data.thinkingBit}/`}
              class="think-cta shrink-0 w-11 flex flex-col items-center justify-center gap-2 text-neutral-content bg-neutral active:brightness-95 transition ease-in-out"
              aria-label={`Think with me: ${bit.data.title}`}
            >
              <svg
                class="h-5 w-5 fill-current shrink-0"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
              >
                <path d="M12 2a7 7 0 0 0-4 12.74V17a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-2.26A7 7 0 0 0 12 2Zm-3 19a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1v-1H9Z" />
              </svg>
              <svg
                class="h-4 w-4 fill-current shrink-0"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
              >
                <path d="M8.59 16.58 13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.42Z" />
              </svg>
            </a>
          )}
        </div>
      ))}
    </div>
  </div>

  <div class="divider divider-neutral my-6"></div>

  <div>
    <div class="text-3xl w-full font-bold mb-5">Latest from blog</div>
    {
      last_posts.map((post, index) => (
        <>
          <HorizontalCard
            title={post.data.title}
            img={post.data.heroImage}
            desc={post.data.description}
            url={"/blog/" + createSlug(post.data.title, post.slug)}
            target="_self"
            badge={post.data.badge}
            thinkingArticle={post.data.thinkingArticle}
          />
          {index < last_posts.length - 1 && <div class="divider my-0" />}
        </>
      ))
    }
  </div>
</BaseLayout>

<style>
  .think-cta {
    transition: background-color 150ms ease, color 150ms ease;
  }

  .think-cta:hover {
    background-color: oklch(var(--b3));
    color: oklch(var(--bc));
  }
</style>
