---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import CompanyBlock from "../components/cv/CompanyBlock.astro";
import RoleItem from "../components/cv/RoleItem.astro";
---

<BaseLayout title="Resume" sideBarActiveItemID="cv">

  <!-- Print-only header (hidden on screen) -->
  <div class="print-header">
    <img src="/profile.webp" alt="Profile" class="print-avatar" />
    <div class="print-header-info">
      <h1 class="print-name">Sengpraseuth Phrakonkham</h1>
      <p class="print-title">iOS Engineer</p>
      <div class="print-contacts">
        <span class="print-contact-row">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
          website: <a href="https://sengdev.com/">sengdev.com</a>
        </span>
        <span>thinking articles: <a href="https://sengdev.com/thinking-articles">sengdev.com/thinking-articles</a></span>
        <span>blog: <a href="https://sengdev.com/blog">sengdev.com/blog</a></span>
        <span class="print-contact-row">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          contact: asukix@gmail.com
        </span>
        <span class="print-contact-row">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" clip-rule="evenodd" d="M12.026 2c-5.509 0-9.974 4.465-9.974 9.974 0 4.406 2.857 8.145 6.821 9.465.499.09.679-.217.679-.481 0-.237-.008-.865-.011-1.696-2.775.602-3.361-1.338-3.361-1.338-.452-1.152-1.107-1.459-1.107-1.459-.905-.619.069-.605.069-.605 1.002.07 1.527 1.028 1.527 1.028.89 1.524 2.336 1.084 2.902.829.091-.645.351-1.085.635-1.334-2.214-.251-4.542-1.107-4.542-4.93 0-1.087.389-1.979 1.024-2.675-.101-.253-.446-1.268.099-2.64 0 0 .837-.269 2.742 1.021a9.582 9.582 0 0 1 2.496-.336 9.554 9.554 0 0 1 2.496.336c1.906-1.291 2.742-1.021 2.742-1.021.545 1.372.203 2.387.099 2.64.64.696 1.024 1.587 1.024 2.675 0 3.833-2.33 4.675-4.552 4.922.355.308.675.916.675 1.846 0 1.334-.012 2.41-.012 2.737 0 .267.178.577.687.479C19.146 20.115 22 16.379 22 11.974 22 6.465 17.535 2 12.026 2z"/></svg>
          <a href="https://github.com/asukix">github.com/asukix</a>
        </span>
        <span class="print-contact-row">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><circle cx="4.983" cy="5.009" r="2.188"/><path d="M9.237 8.855v12.139h3.769v-6.003c0-1.584.298-3.118 2.262-3.118 1.937 0 1.961 1.811 1.961 3.218v5.904H21v-6.657c0-3.27-.704-5.783-4.526-5.783-1.835 0-3.065 1.007-3.568 1.96h-.051v-1.66H9.237zm-6.142 0H6.87v12.139H3.095z"/></svg>
          <a href="https://www.linkedin.com/in/sengpraseuth-phrakonkham-b1b85290/">linkedin.com/in/sengpraseuth-phrakonkham</a>
        </span>
      </div>
    </div>
  </div>

  <!-- Export button (hidden on print) -->
  <div class="no-print flex justify-end mb-6">
    <button onclick="window.print()" class="btn btn-sm btn-outline gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="7 10 12 15 17 10"/>
        <line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
      Export PDF
    </button>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Profile</div>
  </div>

  <div class="mb-10 text-justify">
    iOS developer with a strong focus on architecture. Working in a large-scale SwiftUI production app since 2024 (MVVM, Clean Architecture, Swinject). Spent the past year driving meaningful architecture improvements: separating domains, introducing use cases, and pushing toward cleaner data flow. Drawn to this role because architecture is treated as a first-class concern.
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <div class="mb-10">
    <CompanyBlock
      company="RDI Software Hungary"
      total="4 yr 1 mo · Full-time"
      location="Debrecen, Hungary · Hybrid"
    >
      <RoleItem
        title="iOS App Developer"
        period="Aug 2024 – Present"
        duration="1 yr 10 mo"
      />
      <RoleItem
        title="Site Reliability Engineer"
        period="Jul 2023 – Jul 2024"
        duration="1 yr 1 mo"
      />
      <RoleItem
        title="iOS App Developer"
        period="Jan 2023 – Jun 2023"
        duration="6 mo"
      />
      <RoleItem
        title="Android Developer"
        period="Jun 2022 – Dec 2022"
        duration="7 mo"
      />
    </CompanyBlock>

    <CompanyBlock
      company="Alföldi Nyomda Zrt."
      total="8 yr 1 mo"
      location="Debrecen, Hungary · On-site"
    >
      <RoleItem
        title="Head of Information Technology"
        period="Jan 2019 – May 2022"
        duration="3 yr 5 mo"
      />
      <RoleItem
        title="SQL Developer"
        period="Apr 2017 – Dec 2018"
        duration="1 yr 9 mo"
      />
      <RoleItem
        title="System Administrator"
        period="Mar 2015 – Dec 2018"
        duration="3 yr 10 mo"
      />
    </CompanyBlock>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="Computer programming"
      subtitle="[2012] to [2016] at [University of Debrecen], [Hungary]"
    />
  </div>

</BaseLayout>

<style>
  /* --- Print header: hidden on screen --- */
  .print-header {
    display: none;
  }

  /* --- Export button: visible on screen only --- */
  @media print {
    .no-print {
      display: none !important;
    }

    /* Show print header */
    .print-header {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 2px solid #ccc;
    }

    .print-avatar {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
    }

    .print-name {
      font-size: 1.5rem;
      font-weight: 700;
      margin: 0 0 0.2rem 0;
    }

    .print-title {
      font-size: 0.95rem;
      color: #555;
      margin: 0 0 0.6rem 0;
    }

    .print-contacts {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      font-size: 0.8rem;
      color: #333;
    }

    .print-contacts a {
      color: #333;
      text-decoration: underline;
    }

    .print-contact-row {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }

    .print-contact-row svg {
      flex-shrink: 0;
      color: #000;
    }

    /* Hide sidebar, mobile header, footer */
    :global(.drawer-side),
    :global(.drawer-toggle),
    :global(.drawer-overlay),
    :global(footer),
    :global(.sticky.top-0.z-30) {
      display: none !important;
    }

    /* Full width content */
    :global(.drawer-content) {
      margin-left: 0 !important;
    }

    /* Page setup — suppress browser date/title header/footer */
    @page {
      size: A4;
      margin: 1.5cm 2cm;
    }

    @page :first {
      margin-top: 1.5cm;
    }

    /* Hide browser-generated headers and footers */
    html {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* Suppress running headers/footers in supporting browsers */
    @page {
      @top-left { content: none; }
      @top-center { content: none; }
      @top-right { content: none; }
      @bottom-left { content: none; }
      @bottom-center { content: none; }
      @bottom-right { content: none; }
    }

    body {
      font-size: 11pt;
      color: #000;
      background: #fff !important;
    }
  }
</style>
