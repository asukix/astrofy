---
import BaseLayout from "../layouts/BaseLayout.astro";
import UpcomingCard from "../components/UpcomingCard.astro";
---

<BaseLayout title="Upcoming site updates" sideBarActiveItemID="upcoming">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">Upcoming site updates</div>
    <div class="text-base-content/70 py-6 max-w-[750px]">
      These are planned improvements and additions to this site. None of them are live yet.
    </div>
    <div class="divider my-0"></div>

    <div class="flex flex-col gap-4 mt-6">
      <UpcomingCard
        title="Projects page rework"
        desc="Cleaner layout and better filtering for the projects section."
      />
      <UpcomingCard
        title="Dark / light theme toggle"
        desc="Manual theme switching in addition to the system preference."
      />
      <UpcomingCard
        title="Search across blog and thinking articles"
        desc="Full-text search to find posts without browsing through pages."
      />
    </div>
  </div>
</BaseLayout>
