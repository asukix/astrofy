---
import BaseLayout from "../layouts/BaseLayout.astro";
import UpcomingCard from "../components/UpcomingCard.astro";
---

<BaseLayout title="Site update plans" sideBarActiveItemID="upcoming">
  <div class="pb-12 mt-5">
    <div class="text-5xl font-bold">Site updates plans</div>
    <div class="text-base-content/70 py-6 max-w-[750px]">
      These are planned improvements and additions to this site. None of them are live yet.
    </div>
    <div class="divider my-0"></div>

    <div class="flex flex-col gap-4 mt-6">
      <UpcomingCard
        title="Thinking articles"
        desc="This will be a new reading mode where some blog articles has a Thinking Article version. In the Thinking Articles you can get context and question and you will have place to write your thoughts and after that you will have functionality to reveal mine."
      />

      
      <UpcomingCard
        title="Thinking Articles magic link"
        desc="If you register you can see the Thinking articles with your own thoughts with a provided link"
      />

      <UpcomingCard
        title="Registration"
      />

      <UpcomingCard
        title="Save your Thinking Articles"
        desc="If you register you can see the Thinking articles with your own thoughts with page functionality after log in"
      />
    </div>
  </div>
</BaseLayout>
