---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../../lib/createSlug"

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection("thinking-articles")).filter((p) => !p.data.draft);
  posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
---

<BaseLayout title="Thinking Articles" sideBarActiveItemID="thinking">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Thinking Articles</div>
    <text class="text-lg">
      Thinking articles contains space for thinking where you can add your thoughts before reading the next part of the article. It also contains extra that is some extra context than a normal blog with a question what you can answer to yourself.
      <br>
      NOTE: This part of the website will be released soon.
    </text>
  </div>

  <!-- Pinned pilot article -->
  <div class="start-here-block mb-2">
    <p class="start-here-label">Start here →</p>
    <a href="/blog/thinking-space-system" class="start-here-card block">
      <h2 class="start-here-title">Thinking Space System</h2>
      <p class="start-here-desc">This is how I create a space where I can enjoy thinking from anywhere without any tool. Read this first to understand the format.</p>
      <span class="badge badge-secondary mt-3">Will be released soon</span>
    </a>
  </div>

  <div class="divider my-4" />

  {
    page.data.length === 0 ? (
      <div class="bg-base-200 border-l-4 border-secondary w-full p-4 min-w-full">
        <p class="font-bold">Sorry!</p>
        <p>There are no thinking articles posts to show at the moment. Check back later!</p>
      </div>
    ) : (
      <ul>
        {page.data.map((post) => (
          <>
            <HorizontalCard
              title={post.data.title}
              img={post.data.heroImage}
              desc={post.data.description}
              url={"/thinking-articles/" + createSlug(post.data.title, post.slug)}
              target="_self"
              badge={post.data.badge}
              tags={post.data.tags}
            />
            <div class="divider my-0" />
          </>
        ))}
      </ul>
    )
  }

  <div class="flex justify-between">
    {
      page.url.prev ? (
        <a href={page.url.prev} class="btn btn-ghost my-10 mx-5">
          {" "}
          <svg
            class="h-6 w-6 fill-current md:h-8 md:w-8"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
          </svg>{" "}
          Recent posts
        </a>
      ) : (
        <div />
      )
    }
    {
      page.url.next ? (
        <a href={page.url.next} class="btn btn-ghost my-10 mx-5">
          Older Posts{" "}
          <svg
            class="h-6 w-6 fill-current md:h-8 md:w-8"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            {" "}
            <path d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
          </svg>
        </a>
      ) : (
        <div />
      )
    }
  </div>
</BaseLayout>

<style>
  .start-here-block {
    padding: 1.25rem 1.5rem;
    background: oklch(var(--b2));
    border-left: 4px solid oklch(var(--p));
    border-radius: 0 0.625rem 0.625rem 0;
  }

  .start-here-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.55;
    margin-bottom: 0.5rem;
  }

  .start-here-card {
    text-decoration: none;
    color: inherit;
  }

  .start-here-card:hover .start-here-title {
    opacity: 0.75;
  }

  .start-here-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
    transition: opacity 150ms ease;
  }

  .start-here-desc {
    font-size: 0.95rem;
    opacity: 0.7;
    line-height: 1.5;
  }
</style>
