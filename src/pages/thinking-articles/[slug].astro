---
import { CollectionEntry, getCollection } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";
import createSlug from "../../lib/createSlug";

import Thought from "../../components/Thought.astro";
import Q from "../../components/Q.astro";
import Mine from "../../components/Mine.astro";
import Extra from "../../components/Extra.astro";

export async function getStaticPaths() {
  const postEntries = await getCollection("thinking-articles");
  return postEntries.map((entry) => ({
    params: { slug: createSlug(entry.data.title, entry.slug) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"thinking-articles">;
}

const { entry } = Astro.props;
const post = entry.data;
const { Content } = await entry.render();
---

<PostLayout
  title={post.title}
  description={post.description}
  pubDate={post.pubDate}
  heroImage={post.heroImage}
  updatedDate={post.updatedDate}
  badge={post.badge}
  tags={post.tags}
>
  <Content components={{ Thought, Q, Mine, Extra }} />
</PostLayout>