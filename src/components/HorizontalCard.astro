---
const {
  title,
  img,
  desc,
  url,
  badge,
  tags,
  thinkingArticle,
  target = "_blank",
} = Astro.props;
import { Image } from "astro:assets";
const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";
---

<div
  class="rounded-lg bg-base-100 flex flex-col md:flex-row md:items-stretch overflow-hidden"
>
  <a href={url} target={target} class="grow transition ease-in-out hover:shadow-xl hover:scale-[102%] hover:z-10 relative rounded-lg">
    <div class="hero-content w-full justify-start flex-col md:flex-row">
      {
        img ? (
          <Image
            src={img}
            width={750}
            height={422}
            format="webp"
            alt={title}
            class="max-w-full md:max-w-[13rem] rounded-lg"
          />
        ) : (
          <div class="wordmark-placeholder max-w-full md:max-w-[13rem] rounded-lg flex items-center justify-center shrink-0">
            <span class="wm-text">SENGDEV<span class="wm-arrow">&gt;</span></span>
          </div>
        )
      }
      <div class="grow w-full">
        <h1 class="text-xl font-bold">
          {title}
          {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
        </h1>
        <p class="py-1 text-1xl">{desc}</p>
        <div class="card-actions justify-end">
          {
            tags &&
              tags.map((tag) => (
                <a href={`${tag_url}/${tag}`} class="badge badge-outline">
                  {tag}
                </a>
              ))
          }
        </div>
      </div>
    </div>
  </a>

  {
    thinkingArticle && (
      <a
        href={`/thinking-articles/${thinkingArticle}/`}
        class="think-cta group shrink-0 flex md:flex-col items-center justify-center gap-2 px-6 py-4 md:w-44 font-semibold text-primary-content bg-gradient-to-br from-primary to-secondary hover:brightness-110 active:brightness-95 transition ease-in-out"
        aria-label={`Think with me: ${title}`}
      >
        <svg
          class="h-5 w-5 fill-current shrink-0"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
        >
          <path d="M12 2a7 7 0 0 0-4 12.74V17a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-2.26A7 7 0 0 0 12 2Zm-3 19a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1v-1H9Z" />
        </svg>
        <span class="text-center leading-tight">think with me</span>
        <svg
          class="h-4 w-4 fill-current shrink-0 group-hover:translate-x-1 md:group-hover:translate-x-0 md:group-hover:translate-y-1 transition"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
        >
          <path d="M8.59 16.58 13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.42Z" />
        </svg>
      </a>
    )
  }
</div>

<style>
  .wordmark-placeholder {
    width: 13rem;
    height: 7.5rem;
    background: oklch(var(--b2));
  }

  .wm-text {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    opacity: 0.6;
  }

  .wm-arrow {
    opacity: 0.4;
  }
</style>