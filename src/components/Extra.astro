---
---
<div class="extra-block" data-extra data-open="false">
  <div class="extra-content">
    <div class="extra-inner">
      <p class="extra-label">→ Keep thinking</p>
      <slot />
    </div>
  </div>
</div>

<style>
  .extra-block {
    margin-top: 2.5rem;
  }
  .extra-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 220ms ease;
  }
  .extra-inner {
    overflow: hidden;
  }
  [data-extra][data-open="true"] .extra-content {
    grid-template-rows: 1fr;
  }
  [data-extra][data-open="true"] .extra-inner {
    padding: 1.25rem 1.5rem;
    background: oklch(var(--b2));
    border-left: 4px solid oklch(var(--p));
    border-radius: 0 0.625rem 0.625rem 0;
    margin-top: 1rem;
  }
  .extra-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.55;
    margin-bottom: 0.75rem;
    margin-top: 0;
  }
</style>