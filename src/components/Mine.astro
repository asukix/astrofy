---
---
<div class="mine-block" data-mine data-open="false">
  <div class="mine-columns">

    <div class="mine-col mine-reader-col">
      <p class="mine-col-label">Your thought</p>
      <textarea
        class="textarea textarea-bordered w-full mine-reader"
        placeholder="What do you think?"
        data-reader-box
        rows="4"
        autocomplete="off"
      ></textarea>
    </div>

    <div class="mine-col mine-author-col">
      <p class="mine-col-label">My thought</p>
      <button
        class="btn btn-sm btn-ghost"
        type="button"
        data-mine-toggle
        aria-expanded="false"
      >
        Show
      </button>
      <div class="mine-content" data-mine-content>
        <div class="mine-content-inner">
          <slot />
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  function checkAllOpen() {
    const allMines = document.querySelectorAll('[data-mine]');
    const allOpen = Array.from(allMines).every(m => m.dataset.open === 'true');
    if (allOpen) {
      const extra = document.querySelector('[data-extra]');
      if (extra) extra.dataset.open = 'true';
      const revealContainer = document.getElementById('reveal-all-container');
      if (revealContainer) revealContainer.style.display = 'none';
    }
  }

  function initMine(mine) {
    const toggle = mine.querySelector('[data-mine-toggle]');
    if (!toggle) return;
    toggle.addEventListener('click', () => {
      const isOpen = mine.dataset.open === 'true';
      const next = !isOpen;
      mine.dataset.open = String(next);
      toggle.setAttribute('aria-expanded', String(next));
      toggle.textContent = next ? 'Hide' : 'Show';
      if (next) checkAllOpen();
    });
  }

  function setup() {
    document.querySelectorAll('[data-mine]').forEach(initMine);
  }

  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .mine-block {
    margin: 1.5rem 0;
    padding: 1.25rem;
    background: oklch(var(--b2) / 0.6);
    border-radius: 0.625rem;
  }
  .mine-columns {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }
  .mine-col {
    flex: 1;
    min-width: 0;
  }
  .mine-col-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.5;
    margin-bottom: 0.5rem;
    margin-top: 0;
  }
  .mine-reader {
    width: 100%;
    resize: vertical;
    min-height: 80px;
  }
  .mine-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 180ms ease;
    margin-top: 0.5rem;
  }
  .mine-content-inner {
    overflow: hidden;
  }
  [data-mine][data-open="true"] .mine-content {
    grid-template-rows: 1fr;
  }
  /* Mobile: egymás alatt */
  @media (max-width: 640px) {
    .mine-columns {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>